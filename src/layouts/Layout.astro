---
const { title = "Bilal Creative Tech - Free Resources for Creators", description = "Download free thumbnail packs, video assets, icons, templates, Shopify themes and more." } = Astro.props;
import { categories } from "../data/resources.js";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">Bilal Creative Tech</a>
      <nav class="nav">
        <a href="/">Home</a>
        <div class="dropdown">
          <span>Categories</span>
          <div class="dropdown-menu">
            {categories.map(cat => (
              <a href={`/category/${cat.slug}`}>{cat.icon} {cat.name}</a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; 2026 Bilal Creative Tech. All resources are free to use.</p>
    </div>
  </footer>

  <style is:global>
    :root {
      --yellow: #FFD400;
      --dark: #14141a;
      --gray: #6b7280;
      --light-bg: #f8f9fb;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Poppins', sans-serif; color: var(--dark); background:#fff; line-height:1.6; }
    a { text-decoration:none; color:inherit; }
    .container { max-width: 1140px; margin:0 auto; padding:0 24px; }

    .site-header { border-bottom:1px solid #eee; position:sticky; top:0; background:#fff; z-index:50; }
    .header-inner { display:flex; align-items:center; justify-content:space-between; height:72px; }
    .logo { font-weight:800; font-size:1.3rem; }
    .nav { display:flex; gap:32px; align-items:center; font-weight:600; }
    .dropdown { position:relative; cursor:pointer; }
    .dropdown-menu { display:none; position:absolute; top:100%; left:0; background:#fff; box-shadow:0 10px 30px rgba(0,0,0,0.1); border-radius:10px; padding:8px; min-width:220px; }
    .dropdown:hover .dropdown-menu { display:block; }
    .dropdown-menu a { display:block; padding:10px 14px; border-radius:6px; font-weight:500; }
    .dropdown-menu a:hover { background: var(--light-bg); }

    .site-footer { background: var(--dark); color:#ccc; padding:32px 0; margin-top:80px; text-align:center; font-size:0.9rem; }
  </style>
</body>
</html>